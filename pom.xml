<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <groupId>org.skylark.bluewhale</groupId>
    <artifactId>bluewhale-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>BlueWhale Context Framework</name>
    <description>知识与记忆统一的 Context 框架，采用 DDD 分层与端口适配器架构</description>

    <modules>
        <module>bluewhale-core</module>
        <module>bluewhale-app</module>
        <module>bluewhale-store-sqlite</module>
        <module>bluewhale-index-adapter</module>
        <module>bluewhale-extract</module>
        <module>bluewhale-interfaces</module>
        <module>bluewhale-client</module>
        <module>bluewhale-starter</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.48</lombok.version>
        <sqlite-jdbc.version>3.54.1.0</sqlite-jdbc.version>
        <archunit.version>1.5.1</archunit.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-app</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-store-sqlite</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-index-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-extract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.skylark.bluewhale</groupId>
                <artifactId>bluewhale-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.xerial</groupId>
                <artifactId>sqlite-jdbc</artifactId>
                <version>${sqlite-jdbc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>17</release>
                    <proc>full</proc>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
